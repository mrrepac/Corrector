<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Corrector</AssemblyName>
    <Version>1.5.0</Version>
    <Product>Corrector</Product>
    <ApplicationIcon>CorrectorTray.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="CorrectorTray.ico" LogicalName="Corrector.CorrectorTray.ico" />
    <EmbeddedResource Include="SettingsWindow.xaml" LogicalName="Corrector.SettingsWindow.xaml" />
    <EmbeddedResource Include="TranslationCard.xaml" LogicalName="Corrector.TranslationCard.xaml" />
    <EmbeddedResource Include="ReviewCard.xaml" LogicalName="Corrector.ReviewCard.xaml" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <Content Include="assets.lock.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="README.md;THIRD_PARTY.md;licenses/*.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>

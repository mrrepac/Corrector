<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="18,14,18,16">
  <Grid.Resources>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource CardText}"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style TargetType="RichTextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
      <Setter Property="IsUndoEnabled" Value="False"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Background" Value="{DynamicResource CardSurface}"/>
      <Setter Property="Foreground" Value="{DynamicResource CardText}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource CardText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource CardText}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource CardAccent}"/>
      <Setter Property="Background" Value="{DynamicResource CardTint}"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardEdge}"
                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CardText}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CardText}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Opacity" Value=".78"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource CardSecondary}" Margin="0,0,0,12"/>
  <TextBlock Grid.Row="1" Text="Было" Style="{StaticResource SectionTitle}"/>
  <RichTextBox Grid.Row="2" x:Name="Before" AutomationProperties.Name="Было — исходный текст"/>
  <TextBlock Grid.Row="3" Text="Стало" Style="{StaticResource SectionTitle}" Margin="0,12,0,5"/>
  <RichTextBox Grid.Row="4" x:Name="After" AutomationProperties.Name="Стало — исправленный текст"/>
  <Button Grid.Row="5" x:Name="Copy" HorizontalAlignment="Left" Margin="0,12,0,0"
          Content="_Скопировать результат" AutomationProperties.Name="Скопировать исправленный текст целиком"/>
</Grid>

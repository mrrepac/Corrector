<DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="24,18,24,18">
  <DockPanel.Resources>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource CardText}"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource CardText}"/>
      <Setter Property="Background" Value="{DynamicResource CardSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardEdge}"/>
      <Setter Property="Padding" Value="13,7"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Box" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1"
                  BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CardSecondary}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CardSecondary}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Opacity" Value=".75"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource CardSecondary}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Box" CornerRadius="8" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1"
                Background="{DynamicResource CardSurface}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource CardTint}"/>
            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CardAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource CardAccent}"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CardText}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CardSecondary}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </DockPanel.Resources>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
    <Button x:Name="Cancel" Content="Отмена" IsCancel="True" Margin="0,0,8,0"/>
    <Button x:Name="Save" Content="Сохранить" IsDefault="True" Background="{DynamicResource CardTint}" Foreground="{DynamicResource CardAccent}"/>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <CheckBox x:Name="Startup" Content="Запускать Corrector при входе в Windows" Margin="0,6,0,8" Foreground="{DynamicResource CardText}"/>
      <CheckBox x:Name="Preload" Content="Загружать модель при запуске и держать в памяти" Margin="0,0,0,20" Foreground="{DynamicResource CardText}"/>
      <TextBlock Text="Корректура и перевод" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
      <UniformGrid Columns="2">
        <RadioButton x:Name="Russian" GroupName="Language" Margin="0,0,4,0" HorizontalContentAlignment="Left" AutomationProperties.Name="Корректура русского">
          <StackPanel><TextBlock FontWeight="SemiBold" Text="Корректура русского"/><TextBlock FontSize="12" Margin="0,2,0,0" Text="Перевод с английского на русский"/></StackPanel>
        </RadioButton>
        <RadioButton x:Name="English" GroupName="Language" Margin="4,0,0,0" HorizontalContentAlignment="Left" AutomationProperties.Name="Корректура английского">
          <StackPanel><TextBlock FontWeight="SemiBold" Text="Корректура английского"/><TextBlock FontSize="12" Margin="0,2,0,0" Text="Перевод с русского на английский"/></StackPanel>
        </RadioButton>
      </UniformGrid>
      <TextBlock Text="Промпты модели" Style="{StaticResource Heading}" Margin="0,20,0,2"/>
      <TextBlock Text="Инструкции сохраняются отдельно для каждого направления." Foreground="{DynamicResource CardSecondary}" TextWrapping="Wrap" Margin="0,0,0,9"/>
      <UniformGrid Columns="3" Margin="0,0,0,9">
        <RadioButton x:Name="Prose" GroupName="Prompt" Content="Проза" Margin="0,0,4,0"/>
        <RadioButton x:Name="Verse" GroupName="Prompt" Content="Стихи" Margin="4,0"/>
        <RadioButton x:Name="Translation" GroupName="Prompt" Content="Перевод" Margin="4,0,0,0"/>
      </UniformGrid>
      <TextBox x:Name="Prompt" AutomationProperties.Name="Промпт модели" TextWrapping="Wrap" AcceptsReturn="True" Height="184"
               Background="{DynamicResource CardSurface}" Foreground="{DynamicResource CardText}" CaretBrush="{DynamicResource CardText}"
               BorderBrush="{DynamicResource CardEdge}" BorderThickness="1" VerticalScrollBarVisibility="Auto" Padding="8"/>
      <Button x:Name="Reset" Content="Восстановить этот промпт" ToolTip="Вернуть исходную инструкцию для выбранного языка и задачи"
              HorizontalAlignment="Left" Margin="0,8,0,0"/>
    </StackPanel>
  </ScrollViewer>
</DockPanel>
